  "timeline": [
    {
      "imageAssetId": 2,
      "startMs": 0,
      "endMs": 4800,
      "narrationText": "समय सबसे कीमती चीज़ है, जो एक बार चला जाए तो कभी वापस नहीं आता।"
    },
    {
      "imageAssetId": 3,
      "startMs": 4800,
      "endMs": 9000,
      "narrationText": "हर सुबह सूरज एक नया मौका लेकर आता है, कुछ नया करने का।"
    },
    {
      "imageAssetId": 5,
      "startMs": 9000,
      "endMs": 15400,
      "narrationText": "लेकिन ज्यादातर लोग इस मौके को पहचान नहीं पाते। वो सोचते हैं कल कर लेंगे, और वो कल कभी नहीं आता।"
    },
    {
      "imageAssetId": 6,
      "startMs": 15400,
      "endMs": 22400,
      "narrationText": "एक किसान जो सही समय पर बीज बोता है, वही अच्छी फसल पाता है। देर से बोया गया बीज कमज़ोर पौधा बनता है।"
    },
    {
      "imageAssetId": 4,
      "startMs": 22400,
      "endMs": 29900,
      "narrationText": "यही नियम ज़िंदगी पर भी लागू होता है। जो लोग समय की कदर करते हैं वो आगे निकल जाते हैं, जो टालमटोल करते हैं वो पीछे रह जाते हैं।"
    },
    {
      "imageAssetId": 11,
      "startMs": 29900,
      "endMs": 37600,
      "narrationText": "सफल लोगों की एक ही आदत होती है — वो समय बर्बाद नहीं करते। वो हर पल का इस्तेमाल सीखने और आगे बढ़ने में करते हैं।"
    },
    {
      "imageAssetId": 15,
      "startMs": 37600,
      "endMs": 46500,
      "narrationText": "समय न पैसे से खरीदा जा सकता है, न उधार लिया जा सकता है। इसलिए आज से ही अपने समय की कीमत समझो। छोटे-छोटे लक्ष्य बनाओ और उन्हें समय पर पूरा करो।"
    },
    {
      "imageAssetId": 17,
      "startMs": 46500,
      "endMs": 53900,
      "narrationText": "मोबाइल और सोशल मीडिया में घंटों बर्बाद मत करो। वो समय किसी किताब को पढ़ने में लगाओ, वो समय कोई नया हुनर सीखने में लगाओ।"
    },
    {
      "imageAssetId": 21,
      "startMs": 53900,
      "endMs": 61200,
      "narrationText": "याद रखो, वक्त किसी का इंतज़ार नहीं करता। जो आज तैयार है, कल वही जीतेगा। इसलिए अभी से शुरुआत करो, बाद में मत सोचो।"
    },
    {
      "imageAssetId": 22,
      "startMs": 61200,
      "endMs": 70091,
      "narrationText": "समय का सदुपयोग ही सफलता की असली चाबी है। आज का दिन फिर कभी नहीं आएगा, तो इसे बर्बाद मत करो — इसे जियो, इसे संवारो।"
    }
  ]
}
